<?xml version="1.0"?>
<robot name="two_link_arm">
  <link name="base">
    <inertial><origin xyz="0 0 0.05"/><mass value="5"/><inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><cylinder radius="0.08" length="0.1"/></geometry><origin xyz="0 0 0.05"/></visual>
  </link>
  <link name="upper">
    <inertial><origin xyz="0 0 0.15"/><mass value="1"/><inertia ixx="0.01" iyy="0.01" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.05 0.05 0.3"/></geometry><origin xyz="0 0 0.15"/></visual>
    <collision><geometry><box size="0.05 0.05 0.3"/></geometry><origin xyz="0 0 0.15"/></collision>
  </link>
  <link name="fore">
    <inertial><origin xyz="0 0 0.125"/><mass value="0.5"/><inertia ixx="0.005" iyy="0.005" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.04 0.04 0.25"/></geometry><origin xyz="0 0 0.125"/></visual>
    <collision><geometry><box size="0.04 0.04 0.25"/></geometry><origin xyz="0 0 0.125"/></collision>
  </link>
  <joint name="shoulder" type="revolute"><parent link="base"/><child link="upper"/><origin xyz="0 0 0.1"/><axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="20" velocity="2"/></joint>
  <joint name="elbow" type="revolute"><parent link="upper"/><child link="fore"/><origin xyz="0 0 0.3"/><axis xyz="0 1 0"/><limit lower="-2" upper="2" effort="10" velocity="2"/></joint>
</robot>
